#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR"

DEFAULT_VERSION="$(
  if [[ -f "${PROJECT_ROOT}/VERSION" ]]; then
    tr -d '[:space:]' < "${PROJECT_ROOT}/VERSION"
  elif [[ -f "${PROJECT_ROOT}/pom.xml" ]]; then
    grep -m1 '<version>' "${PROJECT_ROOT}/pom.xml" | sed 's/.*<version>\(.*\)<\/version>.*/\1/' | tr -d ' '
  else
    echo "0.0.0"
  fi
)"

VERSION="${VERSION:-$DEFAULT_VERSION}"

usage() {
  cat <<EOF
Usage: ./oci8jctl <command>

Commands:
  help                  Show this help message
  build                 Build Docker image (host platform)
  build-arm64           Build Docker image for linux/arm64
  build-amd64           Build Docker image for linux/amd64
  build-multi           Build multi-arch OCI image archive (no push)
  generate-build-info   Generate build-info.properties file
  up                    Start the service
  down                  Stop the service
  logs                  View service logs
  health                Check health status
  query                 Execute test query (use QUERY env var)

Environment:
  VERSION               Override image version (default: VERSION file, else pom.xml)
  QUERY                 SQL query for "query" command

Examples:
  ./oci8jctl build
  VERSION=1.2.3 ./oci8jctl build
  QUERY="SELECT 1 FROM DUAL" ./oci8jctl query
EOF
}

cmd="${1:-help}"

case "$cmd" in
  help|-h|--help)
    usage
    echo ""
    echo "Current version: ${VERSION}"
    echo "Override with: VERSION=x.y.z ./oci8jctl build"
    ;;
  build)
    echo "🐳 Building oci8j-connector image v${VERSION} (host platform)..."
    docker buildx build --load --no-cache -f "${PROJECT_ROOT}/docker/Dockerfile" -t "oci8j-connector:v${VERSION}" -t "oci8j-connector:latest" "${PROJECT_ROOT}"
    echo "✅ Image built successfully: oci8j-connector:v${VERSION} and oci8j-connector:latest"
    ;;
  build-arm64)
    echo "🐳 Building oci8j-connector image v${VERSION} (linux/arm64)..."
    docker buildx build --load --no-cache --platform linux/arm64 -f "${PROJECT_ROOT}/docker/Dockerfile" -t "oci8j-connector:v${VERSION}-arm64" -t "oci8j-connector:latest-arm64" "${PROJECT_ROOT}"
    echo "✅ Image built successfully: oci8j-connector:v${VERSION}-arm64 and oci8j-connector:latest-arm64"
    ;;
  build-amd64)
    echo "🐳 Building oci8j-connector image v${VERSION} (linux/amd64)..."
    docker buildx build --load --no-cache --platform linux/amd64 -f "${PROJECT_ROOT}/docker/Dockerfile" -t "oci8j-connector:v${VERSION}-amd64" -t "oci8j-connector:latest-amd64" "${PROJECT_ROOT}"
    echo "✅ Image built successfully: oci8j-connector:v${VERSION}-amd64 and oci8j-connector:latest-amd64"
    ;;
  build-multi)
    echo "🐳 Building multi-arch OCI image v${VERSION} (linux/amd64,linux/arm64)..."
    mkdir -p "${PROJECT_ROOT}/dist"
    docker buildx build --no-cache --platform linux/amd64,linux/arm64 -f "${PROJECT_ROOT}/docker/Dockerfile" -t "oci8j-connector:v${VERSION}" -t "oci8j-connector:latest" --output "type=oci,dest=${PROJECT_ROOT}/dist/oci8j-connector-${VERSION}.oci.tar" "${PROJECT_ROOT}"
    echo "✅ OCI image archive created: dist/oci8j-connector-${VERSION}.oci.tar"
    ;;
  generate-build-info)
    echo "🔧 Generating build information..."
    chmod +x "${PROJECT_ROOT}/scripts/generate-build-info.sh"
    "${PROJECT_ROOT}/scripts/generate-build-info.sh"
    ;;
  up)
    echo "🚀 Starting oci8j-connector..."
    docker compose -f "${PROJECT_ROOT}/docker/docker-compose.yml" up -d
    ;;
  down)
    echo "🛑 Stopping oci8j-connector..."
    docker compose -f "${PROJECT_ROOT}/docker/docker-compose.yml" down
    ;;
  logs)
    docker compose -f "${PROJECT_ROOT}/docker/docker-compose.yml" logs -f
    ;;
  health)
    echo "🏥 Checking health status..."
    curl -f http://localhost:8080/api/v1/oci8j-connector/healthz || echo "❌ Health check failed"
    ;;
  query)
    if [[ -z "${QUERY:-}" ]]; then
      echo "❌ Error: You must provide a query"
      echo "   Usage: QUERY=\"SELECT 1 FROM DUAL\" ./oci8jctl query"
      exit 1
    fi
    echo "📊 Executing query: ${QUERY}"
    curl -X POST http://localhost:8080/api/v1/oci8j-connector/query \
      -H "Content-Type: application/json" \
      -d "{\"query\": \"${QUERY}\"}" | jq .
    ;;
  *)
    echo "❌ Unknown command: ${cmd}"
    usage
    exit 1
    ;;
esac
